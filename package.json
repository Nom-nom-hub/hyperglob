{
  "bin": {
    "hyperglob": "cli.js",
    "hyperglob-mcp": "mcp.js"
  },
  "description": "A multi-threaded, AST-aware, zero-copy file discovery engine designed to replace legacy globbing for AI agents, monorepos, and high-performance developer tooling.",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "fast-glob": "^3.3.3",
    "fdir": "^6.4.0",
    "glob": "^13.0.6",
    "tinyglobby": "^0.2.15"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./mcp.js": "./mcp.js",
    "./cli.js": "./cli.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "cli.js",
    "mcp.js",
    "cordis.patch.yml",
    "dsh-plugin",
    "scripts/install.js",
    "scripts/native-integrity.js",
    "Cargo.toml",
    "Cargo.lock",
    "build.rs",
    "src",
    "examples",
    "docs",
    "hyperglob.*.node"
  ],
  "keywords": [
    "glob",
    "file-discovery",
    "rust",
    "napi",
    "gitignore",
    "monorepo",
    "ai-agents",
    "deepseek-harness",
    "dsh"
  ],
  "license": "MIT",
  "main": "index.js",
  "module": "index.mjs",
  "name": "@blazeinstall/hyperglob",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nom-nom-hub/hyperglob.git"
  },
  "scripts": {
    "bench": "node bench/run.mjs",
    "build": "node scripts/build-native.mjs",
    "build:debug": "node scripts/build-native.mjs --debug",
    "example": "node examples/prd-examples.js",
    "test": "npm run build && node tools/run-tests.mjs",
    "bench:parity": "node bench/parity.mjs",
    "bench:real": "node bench/real-repo.mjs",
    "bench:check": "node bench/check-regression.mjs",
    "postinstall": "node scripts/install.js"
  },
  "types": "index.d.ts",
  "version": "1.0.7"
}
